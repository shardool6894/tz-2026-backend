# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>

# JWT secret — use a long random string in production
jwt_key=your_super_secret_jwt_key_here

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://technozion.nitw.ac.in

# Resend — for OTP email verification
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Optional) The "from" address shown in OTP emails
# Must be a verified domain in your Resend account
RESEND_FROM_EMAIL=Technozion <noreply@technozion.nitw.ac.in>

# Cloudinary (used by frontend directly, but cloud name referenced in backend validation)
CLOUDINARY_CLOUD_NAME=dpjrslhwg
